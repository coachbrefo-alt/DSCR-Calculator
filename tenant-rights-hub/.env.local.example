# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GoHighLevel webhook URL (from your GHL Automation trigger)
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-webhook-id/webhook-trigger/your-trigger-id

# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense publisher ID (the numeric part only, without "ca-pub-")
NEXT_PUBLIC_ADSENSE_ID=0000000000000000
